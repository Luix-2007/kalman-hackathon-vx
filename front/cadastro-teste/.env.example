# Gere o .env com os outputs da stack: make front-env  (na raiz do repositório)
# Nenhum desses valores é segredo: eles vão para o navegador de qualquer forma.
VITE_API_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/cadastro
VITE_USER_POOL_ID=us-east-1_xxxxxxxxx
VITE_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# Opcional (stack matriz-api): mostra a tela da matriz de obrigações
VITE_MATRIZ_API_URL=https://yyyyyyyyyy.execute-api.us-east-1.amazonaws.com
